NODE_ENV=development
PORT=4001

# MongoDB connection string. When running via docker-compose, host "mongo" resolves
# to the mongo container; when running locally, point this at your local MongoDB.
# Uses its own database ("passport-service"), separate from auth-service's.
MONGO_URI=mongodb://localhost:27017/passport-service

# Auth Service integration — this service has NO JWT_SECRET and never decodes
# tokens locally. Every request is verified by an HTTP call to the Auth Service's
# POST /api/auth/verify.
AUTH_SERVICE_URL=http://localhost:4000
AUTH_VERIFY_TIMEOUT_MS=5000

# Winston
LOG_LEVEL=info

# Kafka (Aiven) — publishes passport.change.stream events on create/update/delete.
# Leave KAFKA_BROKER unset to disable Kafka entirely (e.g. local dev without Aiven
# access) — passport CRUD still works, events are just skipped and logged.
#
# Bootstrap host:port from your Aiven Kafka service overview, e.g.
# KAFKA_BROKER=kafka-xxxxxxxx-yourproject.aivencloud.com:12691
KAFKA_BROKER=
KAFKA_CLIENT_ID=passport-service
# Topic is fixed at "passport.change.stream" (src/config/kafka.ts), not configurable via env.

# mTLS certificates downloaded from the Aiven console (Kafka service -> Overview ->
# "Access Certificate" / "Access Key" / "CA Certificate"). Paths are resolved
# relative to the service root (./certs/...) both locally and in Docker (see
# passport/certs/README.md). Never commit the actual .pem/.cert/.key files.
KAFKA_SSL_CA_PATH=./certs/ca.pem
KAFKA_SSL_CERT_PATH=./certs/service.cert
KAFKA_SSL_KEY_PATH=./certs/service.key
