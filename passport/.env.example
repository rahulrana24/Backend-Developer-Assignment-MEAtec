NODE_ENV=development
PORT=4001

# MongoDB connection string. When running via docker-compose, host "mongo" resolves
# to the mongo container; when running locally, point this at your local MongoDB.
# Uses its own database ("passport-service"), separate from auth-service's.
MONGO_URI=mongodb://localhost:27017/passport-service

# Auth Service integration — this service has NO JWT_SECRET and never decodes
# tokens locally. Every request is verified by an HTTP call to the Auth Service's
# POST /api/auth/verify.
AUTH_SERVICE_URL=http://localhost:4000
AUTH_VERIFY_TIMEOUT_MS=5000

# Winston
LOG_LEVEL=info

# Kafka (Aiven) — publishes passport.change.stream events on create/update/delete.
# Authenticates via SASL_SSL (SCRAM-SHA-256, username/password) rather than a client
# certificate. Leave KAFKA_BROKER unset to disable Kafka entirely (e.g. local dev
# without Aiven access) — passport CRUD still works, events are just skipped and logged.
#
# Bootstrap host:port from your Aiven Kafka service overview (its SASL_SSL listener —
# this is typically a different port than a mTLS-only listener on the same host), e.g.
# KAFKA_BROKER=kafka-xxxxxxxx-yourproject.aivencloud.com:12691
KAFKA_BROKER=
KAFKA_CLIENT_ID=passport-service
KAFKA_CONNECT_TIMEOUT_MS=10000
# Topic is fixed at "passport.change.stream" (src/config/kafka.ts), not configurable via env.

# SASL/SCRAM-SHA-256 credentials from the Aiven console (Kafka service -> Overview ->
# "Connection information", typically the "avnadmin" service user or one you create
# yourself with Kafka ACLs). Never commit the real password — this file only holds
# placeholders; the real values belong in your local, gitignored .env.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# CA certificate downloaded from the Aiven console (Kafka service -> Overview ->
# "CA Certificate") — still required with SASL_SSL to verify the broker's TLS
# certificate, even though there's no client certificate/key anymore. Path is
# resolved relative to the service root (./certs/...) both locally and in Docker
# (see passport/certs/README.md). Never commit the actual .pem file.
KAFKA_SSL_CA_PATH=./certs/ca.pem
