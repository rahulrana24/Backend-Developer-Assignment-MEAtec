NODE_ENV=development
PORT=4000

# MongoDB connection string. When running via docker-compose, host "mongo" resolves
# to the mongo container; when running locally, point this at your local MongoDB.
MONGO_URI=mongodb://localhost:27017/auth-service

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# bcrypt
BCRYPT_SALT_ROUNDS=10
