NODE_ENV=development
PORT=4003

# MongoDB connection string. Uses its own database ("document-service"), separate
# from auth-service's and passport-service's.
MONGO_URI=mongodb://localhost:27017/document-service

# Auth Service integration — this service has NO JWT_SECRET and never decodes
# tokens locally. Every request is verified by an HTTP call to the Auth Service's
# POST /api/auth/verify.
AUTH_SERVICE_URL=http://localhost:4000
AUTH_VERIFY_TIMEOUT_MS=5000

# Winston
LOG_LEVEL=info

# S3-compatible object storage. Works unchanged against real AWS S3 (leave
# S3_ENDPOINT unset, use real AWS credentials/region) or MinIO for local dev
# (set S3_ENDPOINT + S3_FORCE_PATH_STYLE=true, as docker-compose.yml does).
S3_BUCKET=battery-passport-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Leave blank to talk to real AWS S3 instead of a MinIO/S3-compatible endpoint.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# How long a GET /api/documents/:docId presigned download link stays valid, in seconds.
PRESIGNED_URL_EXPIRY_SECONDS=900

# Maximum accepted upload size, in megabytes. multer rejects anything larger with a 400.
MAX_FILE_SIZE_MB=10
