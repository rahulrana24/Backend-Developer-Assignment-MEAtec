NODE_ENV=development
PORT=4002
LOG_LEVEL=info

# Kafka (Aiven) — same broker pattern as passport/, authenticating via SASL_SSL
# (SCRAM-SHA-256, username/password) rather than a client certificate. Leave
# KAFKA_BROKER unset to disable Kafka entirely (e.g. local dev without Aiven access)
# — the service still starts and /health still works, it just never receives events.
KAFKA_BROKER=
KAFKA_CLIENT_ID=notification-service
KAFKA_CONNECT_TIMEOUT_MS=10000
# Topic is fixed at "passport.change.stream" (src/config/kafka.ts), not configurable via env —
# it's the same cross-service contract passport/ publishes to.

# SASL/SCRAM-SHA-256 credentials from the Aiven console (Kafka service -> Overview ->
# "Connection information") — same service user passport/ uses to publish, since
# both talk to the same Aiven Kafka cluster. Never commit the real password — this
# file only holds placeholders; the real values belong in your local, gitignored .env.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# CA certificate — see certs/README.md. Same file as passport/certs/ca.pem (or your
# own, if your Aiven project provisions separate service users). Still required with
# SASL_SSL to verify the broker's TLS certificate, even with no client cert/key.
KAFKA_SSL_CA_PATH=./certs/ca.pem

# false (default) = only consume events published after this service starts.
# true = replay the entire topic history on every fresh start (can spam the inbox).
KAFKA_CONSUMER_FROM_BEGINNING=false

# SMTP — Gmail defaults shown. SMTP_USER/SMTP_PASS must be real credentials you provide
# yourself (e.g. a Gmail "App Password", not your regular account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Battery Passport Notifications
SMTP_FROM_ADDRESS=

# Recipient for every notification email. Test value per the current requirement —
# replace for anything beyond local testing.
NOTIFICATION_RECIPIENT_EMAIL=rahul.rana2000.rr@gmail.com
